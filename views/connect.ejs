<!DOCTYPE html>
<html lang="en">
	<%- include('head'); -%>

	<body>
		<main id="app">
			<div class="wrap max" v-cloak>
				<section id="toast" v-bind:class="toast.type + (toast.message ? ' show' : '')" v-on:click="toast.message = ''">
					{{toast.message}}
				</section>

				<!-- Connected peers list -->
				<section id="peers-list" v-if="callInitiated && peersArray.length">
					<ul style="list-style:none; padding:0; margin:1rem 0; display:flex; gap:1rem; justify-content:center;">
						<li v-for="peer in peersArray" :key="peer.name" style="display:flex;align-items:center;gap:0.5rem;">
							<i :class="['icon-mic', peer.isTalking ? 'green' : '']" style="font-size:1.5rem;"></i>
							<span>{{ peer.name }}</span>
							<audio v-if="peer.stream" v-stream="peer.stream" autoplay playsinline></audio>
						</li>
					</ul>
				</section>

				<div id="blanket" v-if="showExtraControls" @click="resetPopups"></div>
				<section id="controls">
					<section id="extra" v-if="showExtraControls">
						<ul>
							<li class="action" @click="showAudioDevices = !showAudioDevices">
								<i class="icon-mic"></i> Change audio
							</li>
							<li
								class="action indent"
								v-if="showAudioDevices"
								v-for="(audioDevice, i) in audioDevices"
								v-bind:key="audioDevice.deviceId"
								@click="selectedAudioDeviceId = audioDevice.deviceId"
							>
								<i class="icon-minus" v-if="selectedAudioDeviceId !== audioDevice.deviceId"></i>
								<i class="icon-check" v-if="selectedAudioDeviceId === audioDevice.deviceId"></i>
								{{audioDevice.label}}
							</li>
						</ul>
					</section>
					<section id="name" v-if="!callInitiated && !showExtraControls">
						<span class="loading">Connecting...</span>
					</section>
					<section id="buttons">
						<button @click="callInitiated ? toggleAudio() : togglePreCallAudio()">
							<i :class="'icon-mic'+(audioEnabled ? '' : '-off')"></i>
						</button>
						<button class="red" v-if="callInitiated" @click="endCall"><i class="icon-phone-off"></i></button>
						<button @click="copyURL"><i class="icon-link"></i></button>
						<button @click="toggleExtraControls"><i class="icon-more-vertical"></i></button>
						<button class="join" v-if="!callInitiated" v-on:click="autoInitiateCall">
							<i class="icon-phone"></i>&nbsp;Connect
						</button>
					</section>
				</section>
			</div>
		</main>
	</body>
</html>
